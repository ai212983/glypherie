{
  "name": "font-generator-tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "commitlint": "commitlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "hooks:install": "lefthook install",
    "spell:check": "cspell --no-progress --gitignore --no-must-find-files",
    "test": "node --test tests/tooling/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@types/node": "22.20.5",
    "cspell": "10.3.6",
    "lefthook": "2.1.15",
    "oxfmt": "0.77.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
