{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "endOfLine": "lf",
  // Code samples in docs stay exactly as written.
  "embeddedLanguageFormatting": "off",
  "ignorePatterns": [
    "docs/references/VisualTrueType/**",
    "docs/references/specs/**",
    "**/vendor/**",
    "**/package-lock.json",
    "**/*.lock.json",
    "crates/wasm/pkg-*/**",
    // Published capture packages are checksum-pinned; the build guard reads
    // them byte-for-byte, so the formatter must not touch them.
    "apps/web/src/app/features/landing/assets/rasterizers/**",
    // Machine-owned reference data: paper extraction ledgers. Reformatting
    // them is churn with no readers that care about whitespace.
    "**/extraction.json",
    "**/review.json",
    // dprint never covered these languages; keep the migration to its scope
    // plus TypeScript/JavaScript.
    "**/*.css",
    "**/*.html",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    "**/.mise/**",
    "**/node_modules/**",
    "**/target/**",
    "**/out/**",
    "**/.venv/**"
  ]
}
