<figure class="glyph-block"{% if not glyphGroup.ordinaryInitiallyVisible %} hidden{% endif %}>
<figcaption>Changed symbols</figcaption>
<div class="specimen-row glyph-sheet" style="--native-width: {{ glyphGroup.canvas.width_px }}px; --native-height: {{ glyphGroup.canvas.height_px }}px; --origin-x: {{ glyphGroup.canvas.origin_x }}px; --canvas-padding: {{ glyphGroup.canvas.padding_px }}px; --line-height: {{ glyphGroup.lineHeight }}px"{% if not glyphGroup.initiallyVisible %} hidden{% endif %}>
  {% for glyph in glyphGroup.glyphs %}{% for profile in glyph.profiles %}{% if not profile.attention %}
  <a class="specimen-card glyph-link" style="--advance: {{ profile.advance_px }}px" data-profile="{{ profile.id }}" data-codepoint="{{ glyph.codepoint }}" data-preserve-controls data-target-zoom-scope="glyph"
     href="{{ siteBase }}{{ comparison.id }}/{{ family.id }}/{{ glyph.slug }}/#{{ glyphGroup.anchor }}" target="_blank" rel="noopener" aria-label="Compare {{ glyph.character }} in {{ family.name }}, {{ glyphGroup.size_px }} px" title="{{ glyph.character }} · {{ glyphGroup.size_px }} px"{% if not profile.initiallyVisible %} hidden{% endif %}>
    <img src="{{ siteBase }}comparison-content/{{ comparison.packageId }}/{{ profile.current.path }}" width="{{ glyphGroup.canvas.width_px }}" height="{{ glyphGroup.canvas.height_px }}" alt="{{ glyph.character }}" loading="lazy" decoding="async">
  </a>
  {% endif %}{% endfor %}{% endfor %}
</div>
</figure>
