---
pagination:
  data: glyphPages
  size: 1
  alias: glyphPage
permalink: "{{ glyphPage.comparison.id }}/{{ glyphPage.familyId }}/{{ glyphPage.slug }}/index.html"
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ glyphPage.familyName }} — {{ glyphPage.character }} comparison</title>
  <link rel="stylesheet" href="../../../assets/index.css">
  <script type="module" src="../../../assets/index.js"></script>
</head>
<body data-zoom-scope="glyph">
  <a class="skip-link" href="#specimens">Skip to comparisons</a>
  {% set comparison = glyphPage.comparison %}
  {% set heading = glyphPage.familyName + " — " + glyphPage.character %}
  {% set backUrl = "../../../#family-" + glyphPage.familyId %}
  {% set backLabel = "All symbols" %}
  {% include "comparison-header.njk" %}
  <main id="specimens">
    <p class="intro diff-legend"><span class="added-key">Blue: added ink</span><span class="removed-key">Red: removed ink</span><span>Unchanged pixels keep their original shade.</span></p>
    <p class="intro" id="no-pixel-changes" hidden>No pixel changes in this output mode.</p>
    <section class="family" id="family-{{ glyphPage.familyId }}">
      {% for group in glyphPage.sizes %}
      <section class="size-group" id="{{ group.anchor }}" style="--native-width: {{ group.canvas.width_px }}px; --native-height: {{ group.canvas.height_px }}px"{% if not group.initiallyVisible %} hidden{% endif %}>
        <h2>{{ group.size_px }} px</h2>
        {% if group.attention %}
        <div class="attention-note" data-attention-profile="{{ group.profiles[0].id }}">
          <strong>{{ group.attention.inspection }}</strong>
          {% if group.attention.description %}<p>{{ group.attention.description }}</p>{% endif %}
        </div>
        {% endif %}
        {% for profile in group.profiles %}
        <div class="specimen-row comparison-row">
          {% for kind in ["previous", "current", "difference"] %}
          <figure class="specimen-card" data-profile="{{ profile.id }}" data-kind="{{ kind }}"{% if not profile.initiallyVisible %} hidden{% endif %}>
            <figcaption>{% if kind == "previous" %}Previous · {{ comparison.previous.label }}{% elif kind == "current" %}Current · {{ comparison.current.label }}{% else %}Difference{% endif %}</figcaption>
            <div class="image-viewport" tabindex="0" role="region" aria-label="{{ glyphPage.character }}, {{ group.size_px }} px, {{ kind }}">
              <img src="../../../comparison-content/{{ comparison.packageId }}/{{ profile[kind].path }}" width="{{ group.canvas.width_px }}" height="{{ group.canvas.height_px }}" alt="{{ glyphPage.character }} — {{ kind }}, {{ group.size_px }} px" loading="lazy" decoding="async">
            </div>
          </figure>
          {% endfor %}
        </div>
        {% endfor %}
      </section>
      {% endfor %}
    </section>
  </main>
</body>
</html>
