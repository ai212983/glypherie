---
permalink: index.html
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Font preview</title>
  <link rel="stylesheet" href="./assets/index.css">
  <script type="module" src="./assets/index.js"></script>
</head>
<body>
  <a class="skip-link" href="#specimens">Skip to specimens</a>
  <header class="page-header page-header--sticky">
    <div class="heading">
      <p class="eyebrow">Font workshop</p>
      <h1>Font preview</h1>
      {% if specimens.state == "ready" %}
      <p class="variant">{% if activeComparison %}<span>{% if activeComparison.previous.label == "Reference" %}reference{% else %}{{ activeComparison.previous.label }}{% endif %}</span> → {% endif %}<span>{{ specimens.variantLabel }}</span></p>
      {% endif %}
    </div>
    {% if specimens.state == "ready" %}
    <div class="header-controls">
    <fieldset class="profile-switch" id="output-mode" disabled>
      <legend>Output mode</legend>
      <div class="profile-options">
        {% for profile in specimens.profiles %}
        <label>
          <input type="radio" name="output-profile" value="{{ profile.id }}"{% if profile.id == specimens.defaultProfile %} checked{% endif %}>
          <span>{{ profile.label }}</span>
        </label>
        {% endfor %}
      </div>
    </fieldset>
    <div class="zoom-control">
      <div class="zoom-heading">
        <label for="zoom">Zoom</label>
        <output id="zoom-value" for="zoom">1×</output>
      </div>
      <input id="zoom" type="range" min="0" max="3" step="1" value="0" aria-valuetext="1×" aria-describedby="zoom-help" disabled>
      <div class="zoom-stops" aria-hidden="true"><span>1×</span><span>2×</span><span>3×</span><span>4×</span></div>
      <p id="zoom-help">Enlarge pixels to inspect detail.</p>
    </div>
    </div>
    {% endif %}
  </header>
  <main id="specimens">
    {% if specimens.state == "empty" %}
    <section class="content-state">
      <h2>No generated specimens yet.</h2>
      <p>Generate the configured specimens and rebuild this page with <code>just preview-build</code>.</p>
    </section>
    {% elif specimens.state == "error" %}
    <section class="content-state" role="alert">
      <h2>Specimens could not be loaded.</h2>
      <p>{{ specimens.message }}</p>
      <p>Check the selected package, then rebuild the page.</p>
      <details><summary>Selection details</summary><p>{{ specimens.selectedVariant }}</p></details>
    </section>
    {% else %}
    <noscript><p class="intro">Images are displayed at native size.</p></noscript>
    {% for family in specimens.families %}
    <section class="family" id="family-{{ family.id }}" aria-labelledby="heading-{{ family.id }}"{% if not family.initiallyVisible %} hidden{% endif %}>
      <h2 id="heading-{{ family.id }}">{{ family.name }}</h2>
      {% for group in family.sizes %}
      <section class="size-group" id="{{ family.id }}-size-{{ group.size_px }}" aria-labelledby="size-{{ family.id }}-{{ loop.index }}" style="--native-width: {{ group.thumbnail.width_px }}px; --native-height: {{ group.thumbnail.height_px }}px"{% if not group.initiallyVisible %} hidden{% endif %}>
        <h3 id="size-{{ family.id }}-{{ loop.index }}">{{ group.size_px }} <span>px</span></h3>
        <div class="specimen-row">
          {% for item in group.items %}
          <figure class="specimen-card" data-item-id="{{ item.id }}" data-profile="{{ item.profile }}"{% if not item.initiallyVisible %} hidden{% endif %}>
            <figcaption>{{ item.label }}</figcaption>
            <div class="image-viewport" tabindex="0" role="region" aria-label="{{ family.name }}, {{ group.size_px }} px, {{ item.profileLabel }}, {{ item.label }}">
              {% if item.outcome == "rendered" %}
              <img src="{{ item.imageUrl }}" width="{{ group.thumbnail.width_px }}" height="{{ group.thumbnail.height_px }}" alt="{{ item.text }}" loading="lazy" decoding="async">
              {% else %}
              <div class="sample-failure"><strong>{% if item.outcome == "failed" %}Sample could not be rendered{% else %}Sample is unsupported{% endif %}</strong><p>{{ item.reason }}</p></div>
              {% endif %}
            </div>
          </figure>
          {% endfor %}
        </div>
        {% if activeComparison and group.attentionGroups.length %}
        <section class="attention-block" id="attention-{{ family.id }}-{{ group.size_px }}" aria-labelledby="attention-heading-{{ family.id }}-{{ group.size_px }}"{% if not group.attentionInitiallyVisible %} hidden{% endif %}>
          <h4 class="attention-heading" id="attention-heading-{{ family.id }}-{{ group.size_px }}">Attention</h4>
          {% for inspectionGroup in group.attentionGroups %}
          <section class="attention-group"{% if not inspectionGroup.initiallyVisible %} hidden{% endif %}>
          <h5>{{ inspectionGroup.inspection }}</h5>
          <div class="attention-grid">
            {% for symbol in inspectionGroup.symbols %}{% for profile in symbol.profiles %}
            <a class="specimen-card attention-symbol" data-attention-id="{{ symbol.id }}" data-profile="{{ profile.id }}" data-preserve-controls data-target-zoom-scope="glyph"
               href="./{{ activeComparison.id }}/{{ symbol.family_id }}/{{ symbol.slug }}/#{{ symbol.anchor }}" target="_blank" rel="noopener"
               style="--native-width: {{ symbol.canvas.width_px }}px; --native-height: {{ symbol.canvas.height_px }}px"{% if not profile.initiallyVisible %} hidden{% endif %}>
              <strong>{{ symbol.character }}</strong>
              <div class="image-viewport"><img src="./comparison-content/{{ activeComparison.packageId }}/{{ profile.current.path }}" width="{{ symbol.canvas.width_px }}" height="{{ symbol.canvas.height_px }}" alt="{{ symbol.character }}" loading="lazy" decoding="async"></div>
              {% if symbol.description %}<span class="attention-description">{{ symbol.description }}</span>{% endif %}
            </a>
            {% endfor %}{% endfor %}
          </div>
          </section>
          {% endfor %}
        </section>
        {% endif %}
        {% if group.glyphPreview %}
        {% set comparison = activeComparison %}
        {% set glyphGroup = group.glyphPreview %}
        {% set siteBase = "./" %}
        {% include "glyph-sheet.njk" %}
        {% endif %}
      </section>
      {% endfor %}
    </section>
    {% endfor %}
    <footer class="page-footer">
      {% if activeComparison and activeComparison.statistics.length %}
      <p>Compared with {{ activeComparison.previous.label }} across all families and sizes.</p>
      {% for stats in activeComparison.statistics %}
      <div data-impact-profile="{{ stats.profile }}"{% if stats.profile != specimens.defaultProfile %} hidden{% endif %}>
        <dl class="impact-stats">
          <div><dt>Same symbols</dt><dd>{{ stats.sameLabel }}</dd></div>
          <div><dt>Changed symbols</dt><dd>{{ stats.changedLabel }}</dd></div>
          <div><dt>Average changed pixels</dt><dd>{{ stats.averageLabel }}</dd></div>
        </dl>
      </div>
      {% endfor %}
      {% else %}
      <p>Comparison statistics are unavailable.</p>
      {% endif %}
    </footer>
    {% endif %}
  </main>
</body>
</html>
