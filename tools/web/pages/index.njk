---
permalink: index.html
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Font preview</title>
  <link rel="stylesheet" href="./assets/index.css">
  <script type="module" src="./assets/index.js"></script>
  <script type="module" src="./assets/interactive.js"></script>
</head>
<body>
  <a class="skip-link" href="#specimens">Skip to specimens</a>
  <header class="page-header page-header--sticky">
    <div class="heading">
      <p class="eyebrow">Font workshop</p>
      <h1>Font preview</h1>
      {% if specimens.state == "ready" %}
      <p class="variant">{% if activeComparison %}<span>{% if activeComparison.previous.label == "Reference" %}reference{% else %}{{ activeComparison.previous.label }}{% endif %}</span> → {% endif %}<span>{{ specimens.variantLabel }}</span></p>
      {% endif %}
    </div>
    {% if specimens.state == "ready" %}
    <div class="header-controls">
    <fieldset class="profile-switch" id="output-mode" disabled>
      <legend>Output mode</legend>
      <div class="profile-options">
        {% for profile in specimens.profiles %}
        <label>
          <input type="radio" name="output-profile" value="{{ profile.id }}"{% if profile.id == specimens.defaultProfile %} checked{% endif %}>
          <span>{{ profile.label }}</span>
        </label>
        {% endfor %}
      </div>
    </fieldset>
    <div class="zoom-control">
      <div class="zoom-heading">
        <label for="zoom">Zoom</label>
        <output id="zoom-value" for="zoom">1×</output>
      </div>
      <input id="zoom" type="range" min="0" max="3" step="1" value="0" aria-valuetext="1×" aria-describedby="zoom-help" disabled>
      <div class="zoom-stops" aria-hidden="true"><span>1×</span><span>2×</span><span>3×</span><span>4×</span></div>
      <p id="zoom-help">Enlarge pixels to inspect detail.</p>
    </div>
    </div>
    {% endif %}
  </header>
  <main id="specimens">
    {% if specimens.state == "empty" %}
    <section class="content-state">
      <h2>No generated specimens yet.</h2>
      <p>Generate the configured specimens and rebuild this page with <code>just preview-build</code>.</p>
    </section>
    {% elif specimens.state == "error" %}
    <section class="content-state" role="alert">
      <h2>Specimens could not be loaded.</h2>
      <p>{{ specimens.message }}</p>
      <p>Check the selected package, then rebuild the page.</p>
      <details><summary>Selection details</summary><p>{{ specimens.selectedVariant }}</p></details>
    </section>
    {% else %}
    <noscript><p class="intro">The interactive preview needs JavaScript.</p></noscript>
    <div class="font-picker">
      <label for="font-select">Font</label>
      <select id="font-select">
        {% for family in specimens.families %}
        <option value="{{ family.id }}"{% if loop.first %} selected{% endif %}>{{ family.name }}</option>
        {% endfor %}
      </select>
    </div>
    {% for family in specimens.families %}
    <section class="family" id="family-{{ family.id }}" aria-labelledby="heading-{{ family.id }}"{% if not loop.first %} hidden{% endif %}>
      <h2 id="heading-{{ family.id }}">{{ family.name }}</h2>
      <dl class="font-metadata" aria-label="{{ family.name }} font metadata">
        <div><dt>Kerning</dt><dd>{{ family.metadataView.kerningLabel }}</dd></div>
        <div><dt>Axes</dt><dd>{{ family.metadataView.axesLabel }}</dd></div>
        {% if family.metadataView.classificationLabel %}
        <div><dt>Classification</dt><dd>{{ family.metadataView.classificationLabel }}</dd></div>
        {% endif %}
      </dl>
      {% if family.interactive %}
      <section class="interactive-specimen" id="interactive-{{ family.id }}" data-interactive-family="{{ family.id }}"
        data-available="{{ family.interactive.available }}"
        data-font-url="{{ family.interactive.fontUrl or "" }}" data-default-size="{{ family.interactive.default_size_px or 16 }}"
        data-default-axes="{{ (family.interactive.default_axes or {}) | dump }}" data-axes="{{ family.interactive.axes | dump }}"
        data-render="{{ (family.interactive.render or {}) | dump }}" data-sample-text="{{ family.interactive.sample_text or "Aa" }}"
        data-presets="{{ family.interactive.presets | dump }}" hidden>
        <h3 class="interactive-heading">Interactive specimen</h3>
        <p class="interactive-status" data-status role="status" hidden></p>
        <fieldset class="interactive-controls">
          <legend class="visually-hidden">{{ family.name }} interactive controls</legend>
          <label class="interactive-field">Font size (px)
            <input type="number" data-size min="1" max="512" step="0.5" value="{{ family.interactive.default_size_px or 16 }}">
          </label>
          {% for axis in family.interactive.axes %}
          <div class="interactive-field">
            <label for="interactive-{{ family.id }}-{{ axis.tag }}">{{ axis.name }} ({{ axis.tag }})</label>
            <div class="interactive-axis">
              <input id="interactive-{{ family.id }}-{{ axis.tag }}" type="range" data-axis="{{ axis.tag }}"
                min="{{ axis.min }}" max="{{ axis.max }}" step="{{ axis.step }}" value="{{ axis.default }}">
              <output data-axis-value="{{ axis.tag }}">{{ axis.default }}</output>
            </div>
          </div>
          {% endfor %}
          <label class="interactive-field">Preset
            <select data-preset>
              {% for preset in family.interactive.presets %}
              <option value="{{ preset.id }}"{% if preset.id == family.interactive.default_preset %} selected{% endif %}>{{ preset.title }}</option>
              {% endfor %}
              <option value="custom"{% if family.interactive.default_preset == "custom" %} selected{% endif %}>Custom</option>
            </select>
          </label>
          <label class="interactive-field interactive-text">Sample text
            <textarea data-text rows="4" maxlength="8192" autocomplete="off" spellcheck="false">{{ family.interactive.sample_text or "Aa" }}</textarea>
          </label>
          <button type="button" data-reset>Reset</button>
        </fieldset>
        <div class="image-viewport interactive-viewport" tabindex="0" role="region" aria-label="{{ family.name }} interactive specimen">
          <canvas class="interactive-canvas">Interactive preview needs JavaScript and the font renderer.</canvas>
        </div>
      </section>
      {% endif %}
    </section>
    {% endfor %}
    {% endif %}
  </main>
</body>
</html>
