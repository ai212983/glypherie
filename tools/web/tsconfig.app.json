{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite-plugin-pwa/react"]
  },
  // Test-only Storybook fixtures live under tests/ but are app-side stories,
  // so they typecheck here (jsx + vite asset types) rather than in the node
  // config, which must not drag src into its program.
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".storybook/**/*.ts",
    "vite.config.ts",
    "vite.ui.ts",
    "pwa.ts",
    "tests/fixtures/**/*.stories.tsx"
  ]
}
