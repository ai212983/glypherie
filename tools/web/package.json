{
  "name": "font-generator-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/stage-wasm.ts --allow-missing",
    "dev": "vite",
    "prebuild": "node scripts/stage-wasm.ts",
    "build": "vite build",
    "preview": "vite preview",
    "prestorybook": "node scripts/stage-wasm.ts",
    "storybook": "storybook dev --host 127.0.0.1 -p 6006 --no-open --disable-telemetry",
    "prebuild-storybook": "node scripts/stage-wasm.ts",
    "build-storybook": "storybook build -o ../../out/storybook --disable-telemetry",
    "pretypecheck": "node scripts/stage-wasm.ts --allow-missing",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node --test tests/unit/*.test.ts tests/browser/*.test.ts tests/build/*.test.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.58.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.21.5",
    "tw-animate-css": "1.4.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-themes": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "playwright-core": "1.63.0",
    "react-colorful": "5.8.1",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
